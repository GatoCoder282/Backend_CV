# ==========================================
# PORTFOLIO API - CONFIGURACIÓN DE ENTORNO
# ==========================================
# IMPORTANTE: Copiar a .env y llenar con valores REALES
# NUNCA commitear .env (ya está en .gitignore)

# BASE DE DATOS
# Desarrollo: SQLite (local)
# DATABASE_URL=sqlite:///./portfolio.db

# Producción: PostgreSQL (recomendado)
DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/portfolio_db

# SEGURIDAD - JWT
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# Debe ser: mínimo 32 caracteres, aleatorio, único por ambiente
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

ALGORITHM=HS256

# Tiempo de expiración del token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# USUARIO SUPERADMIN
# Email que obtendrá rol SUPERADMIN automáticamente al registrarse
SUPERADMIN_EMAIL=your-email@example.com

# ENTORNO
# Valores válidos: dev, staging, prod
# Afecta: logs, CORS, headers de seguridad, secrets expuestos
ENVIRONMENT=dev

# CLOUDINARY - Almacenamiento de imágenes
# Obtener credenciales en: https://cloudinary.com/
# Free plan: 25 GB de almacenamiento
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
